# C-424: the app's own settings. Everything about the board -- flash, PSRAM, cache, the console and the LVGL build every
# project on it shares -- arrives from kbsp's sdkconfig.board, which CMakeLists.txt fetches and reads first. Never copy
# any of it here.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"

# An app never writes otadata, so any reset returns to kodeOS.
CONFIG_KODEOS_BOOT_ROLE_APP=y

# The console over the USB-C cable, and its `screenshot`: how a picture is checked without standing at the board.
CONFIG_KODEOS_CONSOLE=y

# C-426: the radio, for the den's Wi-Fi: AO_Radio (the C5's link, which selects esp-hosted), Wi-Fi on it, and AO_Net
# for kode_http_*. An app's default is none (kaos/Kconfig: on only for kodeOS); these are Kode's network example's.
CONFIG_KODEOS_RADIO=y
CONFIG_KODEOS_WIFI=y
CONFIG_KODEOS_NET=y

# The board compiles Montserrat 14 only, because the launcher draws in its own faces: 28 for the menu's rows.
CONFIG_LV_FONT_MONTSERRAT_28=y
